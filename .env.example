# Qaldyq environment. Copy to .env and fill in; never commit real values.

# 1 = demo accounts, demo menus and demo history; 0 = real deployment.
QALDYQ_DEMO=1

# Telegram bot process (separate from the web server).
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the application, used by the Mini App and the webhook.
QALDYQ_PUBLIC_URL=
# One shared database for web and bot. The old pre-5.4 database is not used.
QALDYQ_DB=data/qaldyq-v5.4.sqlite3
# Public username only; getMe refreshes it in the shared settings at worker startup.
TELEGRAM_BOT_USERNAME=Qalqyq_NOVA_bot
# Leave blank to derive <QALDYQ_PUBLIC_URL>/api/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Secret token checked in the webhook header (server deployment). Local runs use long polling and do not need it.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE=300
TELEGRAM_MAX_ATTEMPTS=5
