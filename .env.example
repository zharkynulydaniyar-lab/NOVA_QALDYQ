# Qaldyq environment. Copy to .env and fill in; never commit real values.

# 1 = demo accounts, demo menus and demo history; 0 = real deployment.
QALDYQ_DEMO=1

# Telegram bot process (separate from the web server).
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the application, used by the Mini App and the webhook.
QALDYQ_PUBLIC_URL=
# Secret token checked in the webhook header (server deployment). Local runs use long polling and do not need it.
TELEGRAM_WEBHOOK_SECRET=
